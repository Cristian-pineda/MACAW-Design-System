{
  "name": "@macaw-ds/icons",
  "version": "0.2.0",
  "description": "A curated Lucide subset behind the MACAW <Icon name /> component",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cristian-pineda/MACAW-Design-System.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsx scripts/generate.ts && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.55.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@macaw-ds/eslint-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
