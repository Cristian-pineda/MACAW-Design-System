{
  "name": "@macaw-ds/ui",
  "version": "0.2.0",
  "description": "MACAW React components: primitives and composed components on Radix, styled with token utilities only",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cristian-pineda/MACAW-Design-System.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js"
    },
    "./badge": {
      "types": "./dist/badge/index.d.ts",
      "import": "./dist/badge/index.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "import": "./dist/card/index.js"
    },
    "./tab-nav": {
      "types": "./dist/tab-nav/index.d.ts",
      "import": "./dist/tab-nav/index.js"
    },
    "./side-nav": {
      "types": "./dist/side-nav/index.d.ts",
      "import": "./dist/side-nav/index.js"
    },
    "./top-bar": {
      "types": "./dist/top-bar/index.d.ts",
      "import": "./dist/top-bar/index.js"
    },
    "./page-header": {
      "types": "./dist/page-header/index.d.ts",
      "import": "./dist/page-header/index.js"
    },
    "./app-shell": {
      "types": "./dist/app-shell/index.d.ts",
      "import": "./dist/app-shell/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && tailwindcss -i src/styles.css -o dist/styles.css --minify && node scripts/check-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "dependencies": {
    "@macaw-ds/icons": "workspace:^",
    "@macaw-ds/tokens": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@macaw-ds/eslint-config": "workspace:*",
    "@macaw-ds/manifest": "workspace:*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
