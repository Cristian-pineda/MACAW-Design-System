{
  "card": {
    "$description": "Component aliases for Card.",
    "radius": {
      "$type": "dimension",
      "$value": "{shape.container}"
    },
    "padding": {
      "$type": "dimension",
      "sm": {
        "$value": "{layout.card-x-sm}"
      },
      "md": {
        "$value": "{layout.card-x}"
      }
    },
    "bg": {
      "$type": "color",
      "default": {
        "$value": "{color.surface.layer-1}"
      },
      "footer": {
        "$value": "{color.surface.layer-2}"
      }
    },
    "line": {
      "$type": "color",
      "$value": "{color.line.default}"
    },
    "shadow": {
      "$type": "shadow",
      "flat": {
        "$value": "{elevation.flat}"
      },
      "raised": {
        "$value": "{elevation.raised}"
      }
    }
  }
}
