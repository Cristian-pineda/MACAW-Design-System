    "tone": {
      "primary": { "$value": "{color.fg.primary}" },
      "secondary": { "$value": "{color.fg.secondary}" },
      "muted": { "$value": "{color.fg.muted}" },
      "inverse": { "$value": "{color.fg.inverse}" },
      "numeric": { "$value": "{color.fg.numeric}" },
