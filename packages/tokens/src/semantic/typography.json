{
  "text": {
    "$description": "Typography roles. Each role is a size, line height, weight and tracking; Tailwind emits text-<role>.",
    "size": {
      "$type": "dimension",
      "display-lg": { "$value": "{font.scale.30}" },
      "display-md": { "$value": "{font.scale.24}" },
      "heading-lg": { "$value": "{font.scale.20}" },
      "heading-md": { "$value": "{font.scale.16}" },
      "heading-sm": { "$value": "{font.scale.14}" },
      "body-lg": { "$value": "{font.scale.16}" },
      "body-md": { "$value": "{font.scale.14}" },
      "body-sm": { "$value": "{font.scale.13}" },
      "label-md": { "$value": "{font.scale.14}" },
      "label-sm": { "$value": "{font.scale.12}" },
      "caption": { "$value": "{font.scale.11}" },
      "numeric-lg": { "$value": "{font.scale.24}" },
      "numeric-md": { "$value": "{font.scale.14}" },
      "numeric-sm": { "$value": "{font.scale.12}" },
      "code": { "$value": "{font.scale.13}" }
    },
    "leading": {
      "$type": "dimension",
      "display-lg": { "$value": "{font.leading.36}" },
      "display-md": { "$value": "{font.leading.32}" },
      "heading-lg": { "$value": "{font.leading.28}" },
      "heading-md": { "$value": "{font.leading.24}" },
      "heading-sm": { "$value": "{font.leading.20}" },
      "body-lg": { "$value": "{font.leading.24}" },
      "body-md": { "$value": "{font.leading.20}" },
      "body-sm": { "$value": "{font.leading.18}" },
      "label-md": { "$value": "{font.leading.20}" },
      "label-sm": { "$value": "{font.leading.16}" },
      "caption": { "$value": "{font.leading.16}" },
      "numeric-lg": { "$value": "{font.leading.32}" },
      "numeric-md": { "$value": "{font.leading.20}" },
      "numeric-sm": { "$value": "{font.leading.16}" },
      "code": { "$value": "{font.leading.20}" }
    },
    "weight": {
      "$type": "fontWeight",
      "display-lg": { "$value": "{font.weight.semibold}" },
      "display-md": { "$value": "{font.weight.semibold}" },
      "heading-lg": { "$value": "{font.weight.semibold}" },
      "heading-md": { "$value": "{font.weight.semibold}" },
      "heading-sm": { "$value": "{font.weight.semibold}" },
      "body-lg": { "$value": "{font.weight.regular}" },
      "body-md": { "$value": "{font.weight.regular}" },
      "body-sm": { "$value": "{font.weight.regular}" },
      "label-md": { "$value": "{font.weight.medium}" },
      "label-sm": { "$value": "{font.weight.medium}" },
      "caption": { "$value": "{font.weight.regular}" },
      "numeric-lg": { "$value": "{font.weight.semibold}" },
      "numeric-md": { "$value": "{font.weight.medium}" },
      "numeric-sm": { "$value": "{font.weight.medium}" },
      "code": { "$value": "{font.weight.regular}" }
    },
    "tracking": {
      "$type": "dimension",
      "display-lg": { "$value": "{font.tracking.tight}" },
      "display-md": { "$value": "{font.tracking.tight}" },
      "heading-lg": { "$value": "{font.tracking.snug}" },
      "heading-md": { "$value": "{font.tracking.snug}" },
      "heading-sm": { "$value": "{font.tracking.normal}" },
      "body-lg": { "$value": "{font.tracking.normal}" },
      "body-md": { "$value": "{font.tracking.normal}" },
      "body-sm": { "$value": "{font.tracking.normal}" },
      "label-md": { "$value": "{font.tracking.normal}" },
      "label-sm": { "$value": "{font.tracking.normal}" },
      "caption": { "$value": "{font.tracking.wide}" },
      "numeric-lg": { "$value": "{font.tracking.snug}" },
      "numeric-md": { "$value": "{font.tracking.normal}" },
      "numeric-sm": { "$value": "{font.tracking.normal}" },
      "code": { "$value": "{font.tracking.normal}" }
    }
  }
}
