{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node", "mdx"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@content/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mdx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "public"]
}
